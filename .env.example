# B3 Ações Pilot - Configurações de Ambiente

# Telegram Bot (Opcional - para receber alertas no celular)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Notificações macOS nativas (1 = ativado, 0 = desativado)
MACOS_NOTIFICATIONS=1

# Parâmetros Operacionais
RISK_MAX_PER_TRADE_PERCENT=0.02
DEFAULT_CAPITAL=10000.00
DATABASE_PATH=portfolio.db

# Conectores de IA (Opcional - Padrão: deterministic = 100% Python local sem LLM)
# Opções: deterministic | auto | agy | gemini_cli | claude_cli | codex_cli |
#         gemini | openai | anthropic | openrouter | groq | deepseek | ollama | openai_compatible
AI_PROVIDER=deterministic
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=60

# Chaves de API específicas (configure apenas a que for usar)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
